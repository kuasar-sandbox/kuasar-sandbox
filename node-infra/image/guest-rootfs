#!/bin/sh
# SPDX-License-Identifier: Apache-2.0
# Assemble the offline sample from the node image's selected native Ubuntu packages.
set -eu
export LC_ALL=C
seed=/usr/share/node-infra/quickstart
root=$seed/rootfs
install -d "$root/bin" "$root/etc" "$root/proc" "$root/dev" "$root/sys" "$root/run" "$root/root" "$root/state"
install -d -m 1777 "$root/tmp"
for program in dash sleep cat tr; do
    src=$(command -v "$program")
    install -m 0755 "$src" "$root/bin/$program"
    # ldd lists both direct and transitive shared objects, plus the ELF interpreter.
    libs=$(ldd "$src")
    printf '%s\n' "$libs" | awk '$2 == "=>" {print $3} $1 ~ /^\// {print $1}' | while read -r lib; do
        install -D -m 0755 "$lib" "$root$lib"
    done
done
ln -s dash "$root/bin/sh"
printf '%s\n' 'root:x:0:0:root:/root:/bin/sh' > "$root/etc/passwd"
printf '%s\n' 'root:x:0:' > "$root/etc/group"
arch=$(dpkg --print-architecture)
printf '{"os":"linux","architecture":"%s","config":{"Entrypoint":["/bin/sleep","infinity"],"User":"0:0","Env":["PATH=/bin"]}}\n' "$arch" > "$seed/runtime.json"
chroot "$root" /bin/sh -c 'test "$(printf abc | /bin/tr a-z A-Z | /bin/cat)" = ABC && /bin/sleep 0'
(cd "$seed" && find rootfs -type f -print0 | sort -z | xargs -0 sha256sum && sha256sum runtime.json) > "$seed/SHA256SUMS"
