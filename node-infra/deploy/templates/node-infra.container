# Trusted administrator system container; privileged is not a tenant boundary.
# Replace all five @...@ tokens before node-infra-ctl install.
[Unit]
Description=kuasar-sandbox node-infra @NAME@
After=network-online.target
Wants=network-online.target

[Container]
Image=@IMAGE@
ContainerName=node-infra-@NAME@
Pull=never
Network=host
# Quadlet 4.9.3 generates Delegate=yes and --cgroups=split.
PodmanArgs=--privileged --cgroupns=private --systemd=always --stop-timeout=420
Volume=@CONFIG_ROOT@/node-conductor/conf.d:/etc/node-conductor/conf.d:ro
Volume=@CONFIG_ROOT@/node-proxy/conf.d:/etc/node-proxy/conf.d:ro
Volume=@CONFIG_ROOT@/node-telemetry/conf.d:/etc/node-telemetry/conf.d:ro
Volume=@CONFIG_ROOT@/connector-vswitch/conf.d:/etc/connector-vswitch/conf.d:ro
Volume=@CONFIG_ROOT@/manifest.yaml:/etc/node-infra/manifest.yaml:ro
Volume=@DATA_ROOT@:/var/lib/node-infra:rw
Volume=/var/lib/node-infra/instances/@NAME@/recovery:/run/node-infra/recovery:rw
Volume=@RUN_ROOT@/netns:/run/netns:rw,rslave
Volume=@RUN_ROOT@/bpf:/sys/fs/bpf:rw
# The image uses STOPSIGNAL SIGRTMIN+3 for the inner systemd PID 1.

[Service]
TimeoutStartSec=240
TimeoutStopSec=600
KillMode=control-group
# Conmon failure reaches systemd's kill phase without a normal container stop.
KillSignal=SIGRTMIN+3
Restart=no
CPUQuota=400%
MemoryMax=6G
TasksMax=infinity

[Install]
WantedBy=multi-user.target
